// foo_dsp_decrackle - resources

#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "version.h"

/////////////////////////////////////////////////////////////////////////////
// Configuration dialog

IDD_DECRACKLE DIALOGEX 0, 0, 274, 168
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "DeCrackle"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Filter",IDC_STATIC,7,12,42,8
    CONTROL         "",IDC_SLIDER_FILTER,"msctls_trackbar32",TBS_HORZ | TBS_NOTICKS | WS_TABSTOP,50,9,180,15
    RTEXT           "0.500",IDC_VALUE_FILTER,234,12,33,8

    LTEXT           "Window",IDC_STATIC,7,34,42,8
    CONTROL         "",IDC_SLIDER_WINDOW,"msctls_trackbar32",TBS_HORZ | TBS_NOTICKS | WS_TABSTOP,50,31,180,15
    RTEXT           "0.500",IDC_VALUE_WINDOW,234,34,33,8

    LTEXT           "Thresld",IDC_STATIC,7,56,42,8
    CONTROL         "",IDC_SLIDER_THRESHOLD,"msctls_trackbar32",TBS_HORZ | TBS_NOTICKS | WS_TABSTOP,50,53,180,15
    RTEXT           "0.500",IDC_VALUE_THRESHOLD,234,56,33,8

    LTEXT           "Surface",IDC_STATIC,7,78,42,8
    CONTROL         "",IDC_SLIDER_SURFACE,"msctls_trackbar32",TBS_HORZ | TBS_NOTICKS | WS_TABSTOP,50,75,180,15
    RTEXT           "0.500",IDC_VALUE_SURFACE,234,78,33,8

    LTEXT           "Dry/Wet",IDC_STATIC,7,100,42,8
    CONTROL         "",IDC_SLIDER_DRYWET,"msctls_trackbar32",TBS_HORZ | TBS_NOTICKS | WS_TABSTOP,50,97,180,15
    RTEXT           "1.000",IDC_VALUE_DRYWET,234,100,33,8

    LTEXT           "Dry/Wet at 0.000 switches to delta monitoring: you hear only what is being removed.",
                    IDC_HINT,7,120,260,16

    PUSHBUTTON      "&Defaults",IDC_DEFAULTS,7,145,54,15
    DEFPUSHBUTTON   "OK",IDOK,159,145,54,15
    PUSHBUTTON      "Cancel",IDCANCEL,217,145,50,15
END

/////////////////////////////////////////////////////////////////////////////
// Version

VS_VERSION_INFO VERSIONINFO
 FILEVERSION FOO_DSP_DECRACKLE_VERSION_COMMA
 PRODUCTVERSION FOO_DSP_DECRACKLE_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "DeCrackle DSP for foobar2000 (Airwindows)"
            VALUE "FileVersion",     FOO_DSP_DECRACKLE_VERSION_STRING
            VALUE "InternalName",    "foo_dsp_decrackle"
            VALUE "LegalCopyright",  "Airwindows algorithm (c) Chris Johnson, MIT license"
            VALUE "OriginalFilename","foo_dsp_decrackle.dll"
            VALUE "ProductName",     "foo_dsp_decrackle"
            VALUE "ProductVersion",  FOO_DSP_DECRACKLE_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
